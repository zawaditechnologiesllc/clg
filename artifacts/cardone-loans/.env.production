# Production API base URL for the Cardone Loans & Grants frontend.
# The frontend (Vercel) and API (Render) are on different domains, so the
# browser must call the API by its absolute URL. Vite inlines this at build
# time into import.meta.env.VITE_API_URL.
#
# Override this in the Vercel project's Environment Variables if your API is
# deployed at a different URL — a dashboard value takes precedence over this file.
VITE_API_URL=https://cardone-loans-api.onrender.com
