# Base URL of the API server the frontend should call.
#
# - Local dev with the API on the same origin (proxy / single host): leave empty.
# - Split deployment (Vercel frontend + Render API): set to the API's absolute
#   URL, e.g. https://cardone-loans-api.onrender.com
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
VITE_API_URL=
